# Parking and booking remain simulated; login uses Google through Supabase.
NEXT_PUBLIC_PARKING_MODE=mock
NEXT_PUBLIC_PUBLIC_API_BASE=http://localhost:3000/api/public
# Optional full zones URL. When unset, reads /zones under NEXT_PUBLIC_PUBLIC_API_BASE.
NEXT_PUBLIC_ZONES_API=
# Full zone detail URL. The client adds the zone query parameter.
NEXT_PUBLIC_DETAILS_API=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
