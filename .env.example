# Parking and booking data remain simulated; authentication always uses Google.
NEXT_PUBLIC_PARKING_MODE=mock
NEXT_PUBLIC_PUBLIC_API_BASE=http://localhost:3000/api/public
NEXT_PUBLIC_DETAILS_API=

# Server only. Never prefix these with NEXT_PUBLIC_.
# OAuth client type: Web application.
# Authorized redirect URI must exactly match AUTH_URL + /api/auth/google/callback.
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate at least 32 random bytes. Do not reuse the example text or commit secrets.
AUTH_SECRET=
