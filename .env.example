# Parking and booking remain simulated; login uses Google through Supabase.
NEXT_PUBLIC_PARKING_MODE=mock
NEXT_PUBLIC_PUBLIC_API_BASE=http://localhost:3000/api/public
# Optional full zones URL. When unset, reads /zones under NEXT_PUBLIC_PUBLIC_API_BASE.
NEXT_PUBLIC_ZONES_API=
# Full zone detail URL. The client adds the zone query parameter.
NEXT_PUBLIC_DETAILS_API=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Maximum time in minutes since Google login. Refreshing a token does not extend it.
AUTH_SESSION_MAX_MINUTES=480

# Set NEXT_PUBLIC_PARKING_MODE=api to use live parking and vehicle reviews.
# PARKING_ADMIN_BASE_URL defaults to https://admin-smart-parking.vercel.app.
# PARKING_USER_API_KEY must match the private key configured in Admin.
